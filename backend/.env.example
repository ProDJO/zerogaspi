# Serveur
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Flouci — clés disponibles sur https://developers.flouci.com
FLOUCI_APP_TOKEN=your_app_token_here
FLOUCI_APP_SECRET=your_app_secret_here

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplace_par_une_chaine_aleatoire_de_64_caracteres_hex

# Emails (Nodemailer — Gmail : activer "App passwords" dans votre compte Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_adresse@gmail.com
SMTP_PASS=votre_app_password

# Base de données PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=ZeroGaspi
DB_PASSWORD=remplace_par_ton_mot_de_passe_postgres
DB_PORT=5432
